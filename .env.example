# GCP project
GCP_PROJECT_ID=

# Google Places API key (restringida por IP en consola GCP)
PLACES_API_KEY=

# IP whitelist middleware (lista separada por comas)
IP_WHITELIST=

# API pagination defaults
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# Set to true in production once App Check is configured (see README).
# Defaults to false so the emulator/CI, which send no token, keep working.
APP_CHECK_ENFORCE=false
